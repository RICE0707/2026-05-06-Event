##Makes the armorstand in pointshop spinn around
execute if score GameStarted Game matches 0 run scoreboard players add levitate_pointshop Timer 1
execute if score GameStarted Game matches 0 run execute if score levitate_pointshop Timer matches 1..20 run execute as @e[tag=!recorder,type=item_display,tag=pointshop_item] at @s run teleport @s ~ ~0.01 ~ ~4.5 ~
execute if score GameStarted Game matches 0 run execute if score levitate_pointshop Timer matches 21..40 run execute as @e[tag=!recorder,type=item_display,tag=pointshop_item] at @s run teleport @s ~ ~-0.01 ~ ~4.5 ~

##When scoreboard too high or too low then jump to the lowest/highest point
execute if score GameStarted Game matches 0 if score select_pshop_01 _core_Pointshop matches ..-1 run scoreboard players set select_pshop_01 _core_Pointshop 27
execute if score GameStarted Game matches 0 if score select_pshop_01 _core_Pointshop matches 28.. run scoreboard players set select_pshop_01 _core_Pointshop 0
execute if score GameStarted Game matches 0 if score select_pshop_02 _core_Pointshop matches ..-1 run scoreboard players set select_pshop_02 _core_Pointshop 27
execute if score GameStarted Game matches 0 if score select_pshop_02 _core_Pointshop matches 28.. run scoreboard players set select_pshop_02 _core_Pointshop 0
execute if score GameStarted Game matches 0 if score select_pshop_03 _core_Pointshop matches ..-1 run scoreboard players set select_pshop_03 _core_Pointshop 27
execute if score GameStarted Game matches 0 if score select_pshop_03 _core_Pointshop matches 28.. run scoreboard players set select_pshop_03 _core_Pointshop 0
execute if score GameStarted Game matches 0 if score select_pshop_04 _core_Pointshop matches ..-1 run scoreboard players set select_pshop_04 _core_Pointshop 27
execute if score GameStarted Game matches 0 if score select_pshop_04 _core_Pointshop matches 28.. run scoreboard players set select_pshop_04 _core_Pointshop 0


